# Copy to .env for local development. Never commit .env or real secret values.
# In production, set these as host secrets / environment variables instead.

PORT=3000
NODE_ENV=development

# SQLite file. Relative paths resolve from the repository root. Never ":memory:".
DATABASE_PATH=./data/dj-requests.sqlite

# Stable public origin that the printed QR code points at (must be absolute http/https).
PUBLIC_BASE_URL=http://localhost:5173

# Shown on the audience page and the DJ dashboard.
EVENT_TITLE=DJ Night

# scrypt hash of the DJ password. Generate with:  npm run hash-password
DJ_PASSWORD_HASH=

# Long random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Session lifetime in hours (default 12).
SESSION_TTL_HOURS=12

# Rate limits per client IP (defaults shown). Raise them only for load tests.
# SUBMISSION_RATE_LIMIT_MAX=30
# SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MS=600000

# Production behind a reverse proxy that terminates HTTPS: set TRUST_PROXY=true so each visitor is
# rate-limited separately, and HOST=127.0.0.1 so the app is reachable only through the proxy.
# TRUST_PROXY=false
# HOST=
